# ---------------------------------------------------------------------------
# В репозиторий попадает только приложение:
#   backend/ (FastAPI + LangGraph + BM25), frontend/ (React + TS + Tailwind),
#   config/, data/case4-dev.json, requirements.txt, start.sh, env.example
# ---------------------------------------------------------------------------

# --- виртуальное окружение и кэши Python ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
.Python
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- секреты и локальные настройки ---
.env
.env.*
!.env.example
*.pem
*.key

# --- фронтенд ---
frontend/node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo

# --- сгенерированные данные (пересоздаются при первом старте) ---
data/chroma/
data/models/
data/bm25/
*.sqlite
*.sqlite3
*.db
*.sqlite-wal
*.sqlite-shm

# --- служебные каталоги инструментов (не часть приложения) ---
.gena-ai/

# --- логи и временные файлы ---
*.log
logs/
tmp/
*.tmp
*.bak
*.swp
.DS_Store
Thumbs.db
.idea/
.vscode/
