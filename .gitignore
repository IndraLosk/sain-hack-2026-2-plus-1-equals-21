# ---------------------------------------------------------------------------
# Пуш на GitHub только приложения.
# В репозиторий попадают: app/, config/, web/, scripts/, requirements.txt,
# run.sh, check_agent.py, README.md, env.example, data/case4-dev.json
# ---------------------------------------------------------------------------

# --- виртуальное окружение и кэши Python ---
*.pyc
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- секреты и локальные настройки ---
.env
.env.*
!.env.example
*.pem
*.key

# --- сгенерированные данные (пересоздаются при первом старте) ---
data/chroma/
data/checkpoints.sqlite
data/checkpoints.sqlite-journal
data/checkpoints.sqlite-wal
data/checkpoints.sqlite-shm
*.sqlite
*.sqlite3
*.db
*.bin
*.pickle

# --- кэши моделей / HuggingFace / Ollama ---
.cache/
models/
*.gguf
*.safetensors

# --- материалы хакатона (не часть приложения) ---
*.pdf
a1.md
_r.py
.gena-ai/

# --- логи и временные файлы ---
*.log
logs/
tmp/
*.tmp
*.bak
*.swp
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- старый файл-заготовка gitignore ---
gitignore.txt
