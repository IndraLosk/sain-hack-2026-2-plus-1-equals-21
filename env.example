# Настройки приложения «Эксперт как плейлист» (ассистент Сэйн).
# Скопируйте в .env и впишите свои ключи:  cp env.example .env
# Файл .env в репозиторий не попадает (см. .gitignore).

# --- LLM: OpenAI-совместимый API. Провайдер: openai | deepseek ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
LLM_BASE_URL=https://bifrost.be-healthy.tech/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1200
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_MIN_REQUEST_INTERVAL=2
RUN_TIMEOUT_SECONDS=2400

# --- LLM: резервный провайдер DeepSeek (LLM_PROVIDER=deepseek) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- API хакатона (данные кейса 4) ---
HACK_API_URL=https://hack-api.be-healthy.tech
HACK_TEAM_TOKEN=
DATASET_CODE=case4-dev-v2

# --- Эмбеддинги: BAAI/bge-m3 на ONNX Runtime (только CPU) ---
# Пусто → веса скачаются один раз в data/models/bge-m3-onnx
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_ONNX_PATH=
EMBEDDING_MAX_LENGTH=512
EMBEDDING_BATCH_SIZE=8
EMBEDDING_THREADS=0

# --- Векторная БД ---
CHROMA_COLLECTION=scientific_articles
CHUNK_SIZE=500
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SIMILARITY=0.55
FRESHNESS_DAYS=7

# --- Хранилища: SQLite по умолчанию, PostgreSQL — через DATABASE_URL ---
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/sain
DATABASE_URL=
SQLITE_PATH=./data/app.sqlite
CHECKPOINTS_DB=./data/checkpoints.sqlite

# --- Прочее ---
CORS_ORIGINS=*
DISCLAIMER=Рекомендации ассистента Сэйн не заменяют консультацию врача
