# Локальные настройки (скопируйте в .env при необходимости)
# LLM — OpenAI-совместимый прокси сервиса хакатона. На стенде организаторы
# задают LLM_BASE_URL / LLM_API_KEY / LLM_MODEL сами. LLM_API_KEY можно не
# указывать в .env: приложение прочитает его из переменной окружения или из
# файла llm.key в корне проекта.
LLM_BASE_URL=https://bifrost.be-healthy.tech/v1
# LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_TEMPERATURE=0.3
LLM_NUM_CTX=8192

# Guardrail-модель (можно оставить той же)
GUARD_MODEL=gpt-6-luna

# Эмбеддинги / векторная база
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=mps

RETRIEVAL_TOP_K=3
FRESHNESS_DAYS=7

# CORS: "*" или список через запятую
CORS_ORIGINS=*